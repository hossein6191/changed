# The deployed Changed contract on GenLayer Studio (chain 61999). Empty: lib/config.ts DEMO_CONTRACT is used.
# With both empty every page says the contract is not deployed yet; NEXT_PUBLIC_MOCK=1 still shows the whole site.
NEXT_PUBLIC_CONTRACT=

# 1: the site runs on an in-memory copy of the contract (lib/chain-mock.ts) with scripted readings of the eight demo
# notices; no wallet and no network. For local work and for showing the pages; never for a public deployment.
NEXT_PUBLIC_MOCK=0

# The public address of the site, used for the links in shared-link previews.
NEXT_PUBLIC_SITE_URL=

# The public source repository (https://github.com/<owner>/<name>): the footer's Source link, and the repository the
# demo event's pinned notice addresses are built from. On Vercel the repository the site was built from is used when
# this is empty (its NEXT_PUBLIC_VERCEL_GIT_* system variables).
NEXT_PUBLIC_REPO_URL=

# The commit (40 hex characters) whose notices/ the demo event reads, as raw.githubusercontent.com serves them.
# Empty: lib/config.ts NOTICES_COMMIT is used; with both empty the demo organizer stays away.
NEXT_PUBLIC_NOTICES_COMMIT=

# The demo event's id, only when the server has no DEMO_ORGANIZER_KEY: the server otherwise finds the newest demo
# event the key opened.
NEXT_PUBLIC_DEMO_EVENT=

# Server only. A throwaway Studio test key that runs the demo festival (tools/open-demo-event.mjs). POST
# /api/demo/reopen opens a fresh demo event with it, and POST /api/demo/notice has it review one of its six fixed
# notices (lib/demo-event.ts) from its own credit. Never a key that holds anything real. Pasted with or without 0x,
# with or without quotes. Unset: the site works, and GET /api/demo/status says exactly why the demo organizer is away.
DEMO_ORGANIZER_KEY=
